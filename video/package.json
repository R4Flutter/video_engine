{
  "name": "video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.506",
    "@remotion/google-fonts": "^4.0.506",
    "@remotion/tailwind-v4": "4.0.506",
    "lucide-react": "^1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.506",
    "roughjs": "^4.6.6",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.506",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "check": "node ../tools/check.mjs && npm run test:director",
    "script": "node ../tools/check.mjs && node ../tools/parse-script.mjs ../script.md src/script.json && npm run direct",
    "script:vox": "node ../tools/check.mjs && node ../tools/parse-script.mjs ../script_vox.md src/script.json && npm run direct",
    "direct": "node --experimental-strip-types ../tools/direct.mjs",
    "qc": "node --experimental-strip-types ../tools/qc.mjs",
    "gate": "node --experimental-strip-types ../tools/qc.mjs --strict",
    "test:director": "node --experimental-strip-types --test ../tools/tests/director.test.mjs",
    "voice": "..\\.venv-tts\\Scripts\\python.exe ../tools/voice.py",
    "align": "python ../tools/align.py && node ../tools/lipsync.mjs",
    "lipsync": "node ../tools/lipsync.mjs",
    "rig": "node ../tools/rig.mjs",
    "footage": "python ../tools/fetch-footage.py",
    "bed": "python ../tools/fetch-imagebed.py",
    "bed:dry": "python ../tools/fetch-imagebed.py --dry",
    "bed:alpha": "python ../tools/transparentize.py",
    "mockup": "python ../tools/app-mockup.py",
    "viral:hook": "python ../tools/viral.py hook",
    "viral:patterns": "python ../tools/viral.py patterns",
    "viral:score": "python ../tools/viral.py score",
    "render": "remotion render FinanceShort out/final.mp4",
    "render:vox": "remotion render VoxExplain out/vox.mp4",
    "render:vox:wide": "remotion render VoxWide out/vox_wide.mp4",
    "render:stick": "remotion render StickmanExplain out/stickman.mp4",
    "lab": "remotion render StickmanLab out/lab.mp4",
    "master": "node ../tools/master.mjs out/vox.mp4 out/vox_upload.mp4",
    "bench": "remotion render VoxExplain out/bench.mp4 --frames=0-149",
    "bench:gpu": "remotion render VoxExplain out/bench.mp4 --frames=0-149 --gl=angle",
    "episode": "node ../tools/episode.mjs --engine finance",
    "episode:vox": "node ../tools/episode.mjs --engine vox"
  },
  "sideEffects": [
    "*.css"
  ]
}
